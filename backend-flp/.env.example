# =============================================
# Flores Eternas LP — Backend (Spring Boot)
# =============================================
# Copia este archivo como ".env" en src/main/resources/ y completa los valores.
# springboot4-dotenv carga automáticamente el .env desde el classpath.
#
# Si necesitas cambiar la configuración para tu entorno local
# (puerto de PostgreSQL, usuario, contraseña, nombre de BD),
# solo modifica el archivo .env en src/main/resources/.env

# Nombre de la aplicación
APP_NAME=backend

# PostgreSQL — URL de conexión
DB_URL=jdbc:postgresql://localhost:5432/flores_eternas_lp

# PostgreSQL — Usuario
DB_USERNAME=postgres

# PostgreSQL — Contraseña
DB_PASSWORD=tu_contraseña_aqui

# Hibernate DDL auto (update | validate | create | create-drop | none)
DDL_AUTO=update

# =============================================
# JWT — Clave secreta (mínimo 64 caracteres para HMAC-SHA)
# =============================================
JWT_SECRET=tu_clave_secreta_jwt_minimo_64_caracteres

# =============================================
# Wompi — Web Checkout (Tarjeta de crédito / débito / PSE / Nequi)
# =============================================
# Obtén estos valores desde tu dashboard de Wompi
WOMPI_PUBLIC_KEY=pub_test_tu_llave_publica
WOMPI_INTEGRITY_SECRET=test_integrity_tu_secreto
WOMPI_PRIVATE_KEY=prv_test_tu_llave_privada
WOMPI_URL=https://sandbox.wompi.co/v1

# =============================================
# Mail — SMTP (para notificaciones al cliente)
# =============================================
MAIL_FROM=tu_correo@gmail.com
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=tu_correo@gmail.com
spring.mail.password=tu_contraseña_de_aplicacion
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

# =============================================
# Frontend — URL base (para construir links)
# =============================================
FRONTEND_URL=http://localhost:3000

# =============================================
# Docker PostgreSQL — Variables (solo para Docker)
# =============================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=tu_contraseña
POSTGRES_DB=floresdb

# =============================================
# Gemini AI — Generación de imágenes (principal)
# =============================================
GEMINI_API_KEY=tu_gemini_api_key

# =============================================
# Hugging Face — Fallback IA (FLUX.1-dev)
# =============================================
HF_API_KEY=hf_tu_token_aqui
