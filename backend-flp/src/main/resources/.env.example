# =============================================
# Spring Boot — Aplicación
# =============================================
APP_NAME=backend

# PostgreSQL — Base de datos
DB_URL=jdbc:postgresql://localhost:5432/flores_eternas_lp
DB_USERNAME=postgres
DB_PASSWORD=tu_contrasena
DDL_AUTO=update

# JWT — Clave secreta (mínimo 64 caracteres para HMAC-SHA)
JWT_SECRET=tu_clave_secreta_jwt_minimo_64_caracteres

# =============================================
# Wompi — Web Checkout (Tarjeta de crédito / débito / PSE / Nequi)
# =============================================
# Obtén estos valores desde tu dashboard de Wompi (Desarrolladores > Llaves)
# https://wompi.com/es/co/desarrolladores
WOMPI_PUBLIC_KEY=pub_test_tu_llave_publica
WOMPI_INTEGRITY_SECRET=test_integrity_tu_secreto
# Llave privada para verificar firma de webhooks
WOMPI_PRIVATE_KEY=prv_test_tu_llave_privada
# URL base del API (sandbox por defecto; cambiar a production.wompi.co para producción)
WOMPI_URL=https://sandbox.wompi.co/v1

# =============================================
# Mail — SMTP (para notificaciones al cliente)
# =============================================
# Ejemplo con Gmail: requiere contraseña de aplicación (no la contraseña normal)
# Cómo crearla: https://myaccount.google.com/apppasswords
MAIL_FROM=tu_correo@gmail.com
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=tu_correo@gmail.com
spring.mail.password=tu_contraseña_de_aplicacion
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

# =============================================
# Frontend — URL base (para construir links)
# =============================================
FRONTEND_URL=http://localhost:3000

# =============================================
# Docker PostgreSQL — Variables (solo para Docker)
# =============================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=tu_contraseña
POSTGRES_DB=floresdb

# =============================================
# Gemini AI — Generación de imágenes (principal)
# =============================================
# Obtén tu API key en: https://aistudio.google.com/apikey
GEMINI_API_KEY=tu_gemini_api_key

# =============================================
# Hugging Face — Fallback IA (FLUX.1-dev)
# =============================================
# Obtén token gratuito en: https://huggingface.co/settings/tokens (permiso read)
HF_API_KEY=hf_tu_token_aqui